{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cali: run unit tests",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "-q",
        "${workspaceFolder}\\tests"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}\\src"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Cali: solve example calibration",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "msc_cali.cli.solve_calibration",
        "--input",
        "${workspaceFolder}\\examples\\calibration_samples.example.jsonl",
        "--output",
        "${workspaceFolder}\\outputs\\camera_to_robot.example.json"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}\\src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "D435f: list connected devices",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "msc_cali.cli.realsense_info"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}\\src"
        }
      },
      "problemMatcher": []
    }
  ]
}
